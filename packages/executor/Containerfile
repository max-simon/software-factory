# Build context is the repository root:
#   podman build -t factory-executor:latest -f packages/executor/Containerfile .
FROM docker.io/library/node:26.13.1-trixie-slim

ARG CLAUDE_CODE_VERSION=2.1.322
ARG COREPACK_VERSION=0.36.0
ARG MISE_VERSION=2026.11.7
ARG MISE_SHA256_AMD64=8f5426d9971eaf713b37509749174ca69cf2f08b8b25e389168dcfcab9cd1a4d
ARG MISE_SHA256_ARM64=e4392a51b1b99107b3dd0c8c1b1efa737b614e15950af34921067ce829929af8

# git and gh from the official GitHub CLI apt repository. xz-utils and unzip
# unpack the archives mise downloads.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git wget xz-utils unzip \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && wget -nv -O /etc/apt/keyrings/githubcli-archive-keyring.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# mise lets the agent, which has no root, install the toolchains a repository
# needs. The release binary is verified against a pinned checksum.
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) asset=x64; sum="$MISE_SHA256_AMD64" ;; \
      arm64) asset=arm64; sum="$MISE_SHA256_ARM64" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && wget -nv -O /usr/local/bin/mise "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${asset}" \
 && echo "${sum}  /usr/local/bin/mise" | sha256sum -c - \
 && chmod 755 /usr/local/bin/mise

# Corepack is no longer bundled with Node 26; it provides the pinned Yarn.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "corepack@${COREPACK_VERSION}" \
 && corepack enable \
 && npm cache clean --force

ENV DISABLE_AUTOUPDATER=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /app

# Every workspace manifest is needed for Yarn to resolve the lockfile, but only
# core and executor sources are shipped.
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/control-plane/package.json packages/control-plane/
COPY packages/core packages/core
COPY packages/executor packages/executor
RUN yarn workspaces focus --production @factory/executor \
 && rm -rf "$(yarn config get cacheFolder)" /root/.cache

# Skills the control plane names in follow-ups. claude reads user skills from
# ~/.claude/skills.
COPY --chown=node:node packages/executor/skills /home/node/.claude/skills

# claude refuses --dangerously-skip-permissions as root; the runner clones into
# the home directory of the image's `node` user (uid 1000).
USER node

# Shims put mise-installed tools on PATH for the agent's non-interactive
# shells, which never run `mise activate`. MISE_YES answers mise's prompts,
# which nobody could answer in a headless container. Versions pinned in
# .nvmrc, .python-version and the like count, not only mise.toml.
ENV PATH="/home/node/.local/share/mise/shims:${PATH}" \
    MISE_YES=1 \
    MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=node,python,ruby,go,java

ENTRYPOINT ["node", "/app/packages/executor/src/main.ts"]
