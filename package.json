{
  "name": "agentic-software-factory",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\" && yarn workspace @factory/web test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env packages/control-plane/src/main.ts",
    "user": "node --env-file-if-exists=.env packages/control-plane/src/user-cli.ts",
    "web:dev": "yarn workspace @factory/web dev",
    "web:build": "yarn workspace @factory/web build",
    "image:build": "podman build -t factory-executor:latest -f packages/executor/Containerfile . && podman build -t factory-reviewer:latest -f packages/reviewer/Containerfile ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
